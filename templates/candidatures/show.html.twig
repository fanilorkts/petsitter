{% extends 'base.html.twig' %}

{% block title %}Candidatures{% endblock %}

{% block body %}
    <h1>Candidatures</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ candidature.id }}</td>
            </tr>
            <tr>
                <th>Message</th>
                <td>{{ candidature.message }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ candidature.statut }}</td>
            </tr>
            <tr>
                <th>Date_candidature</th>
                <td>{{ candidature.dateCandidature ? candidature.dateCandidature|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_candidatures_index') }}">back to list</a>

    <a href="{{ path('app_candidatures_edit', {'id': candidature.id}) }}">edit</a>

    {{ include('candidatures/_delete_form.html.twig') }}
{% endblock %}
